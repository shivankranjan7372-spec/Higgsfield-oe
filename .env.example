# Copy to .env.local. Nothing here is needed to run in mock mode.

# The media gateway key (treg.to). Without it the app runs in mock mode with sample files.
TREG_TOKEN=

# Force a mode: mock | live. Default: live when TREG_TOKEN is set, otherwise mock.
# TREG_MODE=mock

# Stop sending paid requests once this many US dollars were spent in 24 hours.
# Default 5 when unset or not a number. 0 stops all paid requests.
TREG_DAILY_BUDGET_USD=5

# Where the database and generated files live. Default: ./data
# PARALLAX_DATA_DIR=

# Set to 1 to fill a new install with demo content: four house accounts and about sixty
# published pictures (AI-generated samples, each with a prompt and a model id).
# It is added once per data directory. Nobody can sign in as the demo accounts.
# PARALLAX_DEMO_SEED=1

# Demo billing: the free top-up button and free plan upgrades. Open by default in mock mode
# only. A live server keeps it closed unless this is "on". Never turn it on for a public
# server: anyone could mint credits and spend your gateway money.
# PARALLAX_DEMO_BILLING=off

# Set to 1 when serving over https, so the session cookie is marked Secure.
# COOKIE_SECURE=1

# The agent chat. Without these it runs as a mock. (Older SUPER_* names still work.)
# AGENT_MODE=live
# ANTHROPIC_API_KEY=
# ORGO_API_KEY=
# COMPOSIO_API_KEY=

# Run the agent chat on a Hermes agent instead of the built-in loop.
# Read "Engines" in docs/api/agent.md first. Keep the key and the token in files that only
# the server can read.
# AGENT_ENGINE=hermes
# HERMES_URL=http://127.0.0.1:8642
# HERMES_API_KEY_FILE=/path/to/hermes-api.key
# AGENT_ENGINE_TOKEN_FILE=/path/to/engine.token
# AGENT_ENGINE_NAME=Hermes

# Who may chat while the agent is live (any live service above, or the Hermes engine).
# Member emails, comma separated, or * for every signed-in member. Guests never. Unset
# means nobody, so a live agent is closed until you name yourself here.
# AGENT_ALLOWED_EMAILS=you@example.com
